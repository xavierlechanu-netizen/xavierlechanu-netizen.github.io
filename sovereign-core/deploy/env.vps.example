# ============================================================================
# Modèle du fichier sovereign-core/.env pour le VPS.
# deploy/install.sh le copie en .env et remplit lui-même les secrets marqués (auto).
# Le fichier .env ne doit JAMAIS être ajouté à git (il est dans .gitignore).
# ============================================================================

# --- Domaine de l'API (enregistrement DNS A vers l'IP du VPS) ---
API_DOMAIN=api.mon50ccetmoi.com
ACME_EMAIL=admin@mon50ccetmoi.com
CORS_ORIGIN=https://mon50ccetmoi.com

# --- Base PostgreSQL ---
DB_USER=mon50cc_admin
DB_PASSWORD=                     # (auto)

# --- Clés de signature des connexions (JWT ES256) ---
SOVEREIGN_JWT_PRIVATE_KEY=       # (auto)
SOVEREIGN_JWT_PUBLIC_KEY=        # (auto)

# --- Paiements Revolut (facultatif au début) ---
REVOLUT_WEBHOOK_SECRET=

# --- Coffre des preuves : Object Storage OVHcloud, bucket créé AVEC Object Lock ---
# Utilisateur S3 dédié : droit d'écrire et de lire, rien d'autre.
WORM_S3_BUCKET=mon50cc-preuves
WORM_S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
WORM_S3_REGION=gra
WORM_S3_ACCESS_KEY_ID=
WORM_S3_SECRET_ACCESS_KEY=
WORM_RETENTION_DAYS=1826

# --- Sauvegardes de la base : un AUTRE bucket, SANS Object Lock ---
# Utilisateur S3 dédié, différent de celui des preuves (il doit pouvoir supprimer les vieilles sauvegardes).
BACKUP_S3_BUCKET=mon50cc-sauvegardes
BACKUP_S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
BACKUP_S3_REGION=gra
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_RETENTION_DAYS=30
# Phrase de chiffrement des sauvegardes. (auto)
# À RECOPIER dans un gestionnaire de mots de passe : sans elle, les sauvegardes sont illisibles.
BACKUP_PASSPHRASE=
