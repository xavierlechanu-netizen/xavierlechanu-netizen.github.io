# Copier en .env (jamais commité) puis remplir.
DB_USER=mon50cc_admin
DB_PASSWORD=
# Générer avec : node scripts/generate-jwt-keys.js >> .env
SOVEREIGN_JWT_PRIVATE_KEY=
SOVEREIGN_JWT_PUBLIC_KEY=
# 1 seulement derrière un reverse proxy de confiance (X-Forwarded-For)
SOVEREIGN_TRUST_PROXY=0
REVOLUT_WEBHOOK_SECRET=
# Coffre des preuves (obligatoire en production) : bucket créé AVEC Object Lock
# (OVHcloud Object Storage, Gravelines ou Roubaix). Le serveur refuse de démarrer sinon.
WORM_S3_BUCKET=
WORM_S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
WORM_S3_REGION=gra
WORM_S3_ACCESS_KEY_ID=
WORM_S3_SECRET_ACCESS_KEY=
# 1826 jours = 5 ans (durée à valider juridiquement)
WORM_RETENTION_DAYS=1826
